# Postgres connection string. Required for /api/conversations, /api/action-items and /api/health.
# The app builds and runs without it (those routes return 500 with a clear message),
# but conversation persistence needs a real database.
DATABASE_URL=postgresql://user:password@localhost:5432/voxera

# Optional. Without it the app falls back to built-in demo replies,
# translations, transcriptions and action extraction.
GEMINI_API_KEY=
